{
  "info": {
    "_postman_id": "c0ur1er-7rack-1ng-c011ect10n-0002",
    "name": "Courier Tracking API",
    "description": "Import **only this file**. Do not pick an Environment (leave it as No environment).\n\nVariables live on the collection (`baseUrl`, `courierId`). Send the 7 requests from top to bottom.\n\nTo run again, change `courierId` under the collection: **⋯ → Edit → Variables**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "courierId", "value": "postman1" }
  ],
  "item": [
    {
      "name": "1. List stores",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/stores",
        "description": "200. Five stores; `id` is a UUID, not the name."
      }
    },
    {
      "name": "2. First location (inside Ataşehir)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courierId\": \"{{courierId}}\",\n  \"timestamp\": \"2024-01-01T00:01:00Z\",\n  \"latitude\": 40.9923307,\n  \"longitude\": 29.1244229\n}"
        },
        "url": "{{baseUrl}}/api/v1/locations",
        "description": "201. applied=true, distance 0.00, one entrance event."
      }
    },
    {
      "name": "3. Same location again (duplicate)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courierId\": \"{{courierId}}\",\n  \"timestamp\": \"2024-01-01T00:01:00Z\",\n  \"latitude\": 40.9923307,\n  \"longitude\": 29.1244229\n}"
        },
        "url": "{{baseUrl}}/api/v1/locations",
        "description": "200. Idempotent retry."
      }
    },
    {
      "name": "4. Same timestamp, different coordinates (conflict)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courierId\": \"{{courierId}}\",\n  \"timestamp\": \"2024-01-01T00:01:00Z\",\n  \"latitude\": 41.0,\n  \"longitude\": 29.0\n}"
        },
        "url": "{{baseUrl}}/api/v1/locations",
        "description": "409."
      }
    },
    {
      "name": "5. Earlier timestamp (not applied)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courierId\": \"{{courierId}}\",\n  \"timestamp\": \"2024-01-01T00:00:00Z\",\n  \"latitude\": 41.0,\n  \"longitude\": 29.0\n}"
        },
        "url": "{{baseUrl}}/api/v1/locations",
        "description": "201. applied=false. Distance unchanged."
      }
    },
    {
      "name": "6. Total distance",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/couriers/{{courierId}}/distance",
        "description": "200 after request 2. 404 if you skip the POSTs."
      }
    },
    {
      "name": "7. Entrance events",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/entrance-events?courierId={{courierId}}",
        "description": "200. One Ataşehir entrance."
      }
    }
  ]
}
